{
  "name": "web",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "brand:sync": "cp node_modules/@edurune/art/src/brand/rune-gate/art.svg public/brand-mark.svg",
    "codegen": "openapi-ts && oxfmt src/api/generated",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --ignore-path .oxfmtignore",
    "fmt:check": "oxfmt --ignore-path .oxfmtignore --check",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "storybook:build": "storybook build",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "i18n": "lingui extract --clean && lingui compile --typescript"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@edurune/art": "0.1.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@lingui/core": "6.7.0",
    "@lingui/react": "6.7.0",
    "@marsidev/react-turnstile": "1.6.1",
    "@phosphor-icons/react": "^2.1.10",
    "@posthog/react": "1.11.1",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "katex": "0.16.47",
    "mermaid": "^12.0.0",
    "posthog-js": "1.434.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uisfx": "^0.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@lingui/babel-plugin-lingui-macro": "6.7.0",
    "@lingui/cli": "6.7.0",
    "@lingui/vite-plugin": "6.7.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@stylexjs/unplugin": "0.19.0",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.38",
    "@types/node": "^26.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint-plugin-lingui": "0.15.0",
    "oxc-transform-react": "^0.150.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "unplugin": "2.3.11",
    "vite": "8.3.0",
    "vite-plugin-babel": "1.7.3",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-svgr": "5.2.0",
    "wrangler": "4.134.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "lodash-es": "4.18.1"
  }
